# Copy to .env:  cp .env.example .env
# Values below marked (DEV ONLY) are placeholders for local use. Replace them for any real deployment.

# ---------------- PostgreSQL ----------------
POSTGRES_USER=shop
POSTGRES_PASSWORD=shop_dev_password            # (DEV ONLY)
POSTGRES_DB=shop
# Host port published by docker compose (container port is always 5432)
POSTGRES_HOST_PORT=5433

# Connection string used by the api inside docker compose
DATABASE_URL=postgres://shop:shop_dev_password@postgres:5432/shop
# Connection string for running tests/tools from the host machine (compose publishes POSTGRES_HOST_PORT)
TEST_DATABASE_URL=postgres://shop:shop_dev_password@localhost:5433/shop

# ---------------- API ----------------
NODE_ENV=production
API_PORT=4000
# Secrets: at least 32 chars, no defaults in code
SESSION_SECRET=dev-only-session-secret-change-me-0123456789   # (DEV ONLY)
WEBHOOK_SECRET=dev-only-webhook-secret-change-me-0123456789   # (DEV ONLY)

# Cookies / CORS-like origin check (comma separated list of browser origins that may call the API)
ALLOWED_ORIGINS=http://localhost:8080
COOKIE_SECURE=false
SESSION_TTL_HOURS=168
# Number of reverse proxies in front of the api whose X-Forwarded-For we trust (nginx = 1, direct = 0)
TRUST_PROXY_HOPS=1

# Business rules
RESERVATION_MINUTES=15
RETURN_WINDOW_DAYS=14
MAX_PENDING_ORDERS=5
DELIVERY_FEE_KOPECKS=10000
FREE_DELIVERY_FROM_KOPECKS=200000

# Payment stub
# Where the stub posts its signed notifications (the api itself)
WEBHOOK_URL=http://127.0.0.1:4000/payments/webhook
# Public origin of the web app; the stub page lives at <PUBLIC_WEB_URL>/stub/pay/<id>
PUBLIC_WEB_URL=http://localhost:8080
STUB_DELAY_SECONDS=30
WEBHOOK_TOLERANCE_SECONDS=300

# Background jobs (PostgreSQL based)
JOBS_ENABLED=true
JOBS_POLL_MS=1000

# Rate limiting (all counters are stored in PostgreSQL)
LOGIN_WINDOW_SECONDS=900
LOGIN_MAX_PER_IP=30
LOGIN_MAX_PER_IP_ACCOUNT=5
API_RATE_WINDOW_SECONDS=60
API_RATE_MAX_PER_IP=600
WEBHOOK_BAD_SIGNATURE_MAX_PER_MINUTE=30

# Startup tasks of the api container
RUN_MIGRATIONS=true
RUN_SEED=true
SEED_MANAGER_PASSWORD=Manager123!              # (DEV ONLY) demo login: manager@shop.test
SEED_CUSTOMER_PASSWORD=Customer123!            # (DEV ONLY) demo logins: customer1@shop.test .. customer50@shop.test

# ---------------- Web ----------------
WEB_PORT=3000
# Where the Next.js server proxies /api/* when nginx is not in front (also used inside compose)
API_INTERNAL_URL=http://api:4000

# ---------------- nginx ----------------
NGINX_HOST_PORT=8080
